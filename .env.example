# All data belongs to this installation. Use an absolute directory for MCP.
# LINGBRANCH_DATA_DIR=/absolute/path/to/library
LINGBRANCH_MODE=local
LINGBRANCH_PORT=4280
# Server mode requires BOTH variables below, and HTTPS at a reverse proxy.
# LINGBRANCH_MODE=server
# LINGBRANCH_ORIGIN=https://ideas.example.com
# LINGBRANCH_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# LINGBRANCH_HOST=0.0.0.0
