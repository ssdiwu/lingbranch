{
  "name": "lingbranch",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/http.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/http.mjs",
    "mcp": "node --env-file-if-exists=.env server/mcp.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs export",
    "restore": "node --env-file-if-exists=.env server/backup.mjs restore",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "licenses": "node scripts/licenses.mjs",
    "cli": "node --env-file-if-exists=.env cli/lingbranch.mjs",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.31.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "unist-util-visit": "5.0.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssdiwu/lingbranch.git"
  },
  "homepage": "https://github.com/ssdiwu/lingbranch",
  "bugs": {
    "url": "https://github.com/ssdiwu/lingbranch/issues"
  },
  "bin": {
    "lingbranch": "cli/lingbranch.mjs"
  }
}
